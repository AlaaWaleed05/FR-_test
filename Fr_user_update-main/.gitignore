.claude/settings.local.json

# AWS provisioning state (resource IDs, account-specific)
infra/aws/*-ids.env.bak
infra/aws/*-ids.env
infra/aws/.taskdef.json
infra/aws/.s711-probe.json
infra/aws/.spa-fallback.js
infra/aws/.vpc-origin.json
