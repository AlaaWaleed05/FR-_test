# Copy to .env (gitignored) and fill in real local values. Never commit .env.
# Consumed by docker-compose.yml (DB_NAME, DB_BOOTSTRAP_USER, DB_BOOTSTRAP_PASSWORD,
# DB_PORT) and by db/init/01-create-migrator.sh (DB_MIGRATOR_PASSWORD, via the
# container's FRU_MIGRATOR_PASSWORD env var) and, when running the backend locally,
# by application.properties (DB_PORT, DB_MIGRATOR_PASSWORD, FRU_APP_PASSWORD,
# FRU_SEALER_PASSWORD).

DB_NAME=fru
DB_PORT=5432

# Container bootstrap superuser only — never used by Flyway or the application.
DB_BOOTSTRAP_USER=postgres
DB_BOOTSTRAP_PASSWORD=changeme_local_dev_only

# fru_migrator: owns the database and every schema; Flyway connects as this role.
DB_MIGRATOR_PASSWORD=changeme_local_dev_only

# fru_app: the application's runtime connection; owns nothing, INSERT+SELECT on audit only.
FRU_APP_PASSWORD=changeme_local_dev_only

# fru_sealer: the audit seal export role (S2-04) — writes audit_seal/audit_seal_chain only.
# The backend application never connects as this role; it is used by the seal_create()
# export step, invoked externally (psql or a future scheduled job), never by the app itself.
FRU_SEALER_PASSWORD=changeme_local_dev_only

# Uqudo eKYC. Tenant client credentials are supplied at session time and live only here, never
# in a committed file, prompt, log or session report (CLAUDE.md hard rule). Two consumers read
# them directly: the backend's `uqudo-spike` Spring profile (S1-02 device spike), and the opt-in
# HttpUqudoClientLiveTest, which is inert without them.
#
# NOTE: these two variables alone do NOT configure the real adapter. `fru.uqudo.client=http` also
# needs the whole `fru.uqudo.http.*` block, which application.properties documents but deliberately
# leaves commented out and un-defaulted (R-007) — a deployment states those properties in its own
# configuration, wiring them to these variables if it wants to. Setting only these two and
# `fru.uqudo.client=http` fails startup naming all six missing keys, which is the intended
# behaviour, not a bug.
#
# UQUDO_SPIKE_KEY is a throwaway shared secret the spike phone sends as `X-Spike-Key`; any random
# string, and spike-only.
UQUDO_CLIENT_ID=
UQUDO_CLIENT_SECRET=
UQUDO_SPIKE_KEY=

# Uqudo hosts. Configuration, never baked into a build (R-007) — the tenant changes before
# production. Uncomment and set only when they differ from the tenant currently in use.
# UQUDO_AUTH_URL=
# UQUDO_API_BASE=
# UQUDO_JWKS_URL=
# UQUDO_ISSUER=
