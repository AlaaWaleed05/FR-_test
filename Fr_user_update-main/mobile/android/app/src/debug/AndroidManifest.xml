<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- S1-02: a debug build talks to the backend on the laptop over plain http on the LAN.
         Android 9+ with targetSdk 36 blocks cleartext by default; this attribute is merged into
         DEBUG builds only; the main manifest sets nothing, release stays cleartext-free. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
