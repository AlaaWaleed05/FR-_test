<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- D7.1(b): Android 12+ IGNORES a custom `windowBackground` for the launch window and
         uses the OS SplashScreen API instead. With minSdk 24 / targetSdk 36 BOTH paths are
         live, and testing only one is how this gets missed — so the same brand blue is
         declared again here in the API the newer platform actually reads. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/brand_blue</item>
        <!-- AD-012's launcher ruling: this points at the adaptive FOREGROUND layer, so it shows
             the pearl on the navy windowSplashScreenBackground above — the same mark the launcher
             icon and the Flutter splash show. It needs no edit when the mark changes, because the
             layer it names is regenerated by the same script. -->
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/brand_blue</item>
    </style>
</resources>
