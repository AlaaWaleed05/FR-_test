<?xml version="1.0" encoding="utf-8"?>
<!-- D2.4: the mark only, no text — the wordmark scales to under 2 dp at a 48 dp icon.
     The mark is the PEARL since AD-012's launcher ruling (2026-09-12), so the launcher, the
     Android 12+ native splash and the Flutter splash all show the same thing.

     The background is @color/brand_blue, which is the AD-012 navy despite the resource name;
     the foreground is transparent, so the navy is supplied here ONCE rather than baked into the
     layer as well. Both layers are generated by mobile/tool/generate_design3_assets.py from
     Design_3/assets/sfb-logo-circle.png; never hand-edit them. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/brand_blue" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
