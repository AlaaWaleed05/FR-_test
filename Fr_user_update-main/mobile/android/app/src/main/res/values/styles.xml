<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting. Automatically
         removed when the Flutter engine draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Applied as soon as the process has started, and behind the Flutter UI while it runs.
         Brand blue rather than the platform default so the native->Flutter handoff cannot
         flash white between the launch window and the Flutter splash (D7.2). -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/brand_blue</item>
    </style>
</resources>
